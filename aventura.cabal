cabal-version:      3.0
name:               aventura
version:            0.1.0.0
synopsis:           Motor de aventuras de texto en Haskell
author:             Samuel Piña, Alejandro de Vincenzo
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Motor.Tipos,
        Motor.Reconocedor,
        Motor.Mundo,
        Motor.Comandos,
        Motor.Nucleo,
        Motor.Persistencia
    build-depends:
        base >= 4.14 && < 5,
        containers >= 0.6,
        directory >= 1.3,
        filepath >= 1.4
    hs-source-dirs:   src
    default-language: Haskell2010

executable aventura
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >= 4.14 && < 5,
        aventura
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite aventura-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base >= 4.14 && < 5,
        aventura,
        HUnit >= 1.6 
    hs-source-dirs:   test
    default-language: Haskell2010
